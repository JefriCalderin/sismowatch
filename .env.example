# ==============================================================================
# SismoWatch - Variables de Entorno de Ejemplo
# ==============================================================================

# Airflow Core & Security
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.2-python3.11
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY_HERE
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@sismowatch.internal

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=sismo_root
POSTGRES_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Least-Privilege Database Roles
DB_INGEST_USER=role_ingest
DB_INGEST_PASSWORD=CHANGE_ME_INGEST_PASSWORD
DB_TRANSFORM_USER=role_transform
DB_TRANSFORM_PASSWORD=CHANGE_ME_TRANSFORM_PASSWORD
DB_READ_USER=platform_user
DB_READ_PASSWORD=CHANGE_ME_READ_PASSWORD

# Application Security & JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Platform User Credentials (seeded into environment, never hardcoded)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=CHANGE_ME_VIEWER_PASSWORD

# Data Sources (USGS API)
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# AI & LLM Provider (Gemini / OpenAI / Fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_UI_PORT=8080

# OpenMetadata Configuration
OPENMETADATA_SERVER_URL=http://localhost:8585
OPENMETADATA_JWT_TOKEN=
